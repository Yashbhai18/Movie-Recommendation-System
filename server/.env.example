# CinePulse Server Environment Configuration

# Port for the Node/Express backend server (default: 5000)
PORT=5000

# TMDB (The Movie Database) API Key (v3 auth)
# Get a free API key at: https://www.themoviedb.org/settings/api
# Enables dynamic live search and details for millions of movies and TV shows.
# If omitted or left blank, CinePulse seamlessly searches the curated offline catalog.
TMDB_API_KEY=

